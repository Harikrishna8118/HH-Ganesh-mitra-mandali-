# ==============================================================================
# Ganesh Mitra Mandali - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# NEVER commit your actual '.env' file to source control.
# ==============================================================================

# Google Gemini API Key
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Application Hosting URL
# In development, this is typically http://localhost:3000
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Optional: Firebase / Cloud Configuration (if overriding default applet config)
# VITE_FIREBASE_API_KEY="your_firebase_api_key"
# VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
# VITE_FIREBASE_DATABASE_ID="your_firestore_database_id"
